{
  "name": "pdf-batch-classifier",
  "version": "1.0.0",
  "description": "Parses text-based PDFs, classifies them (PO / Invoice / AWB_BL / Shipping Bill), extracts Invoice & PO numbers, and segregates related documents into batches.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "classify": "node index.js",
    "web": "node server.js",
    "generate-samples": "node scripts/generate-samples.js",
    "test": "node scripts/generate-samples.js && node index.js ./sample_pdfs",
    "local:extract-text": "node scripts/extract-text.js"
  },
  "keywords": [
    "pdf",
    "ocr",
    "classification",
    "invoice",
    "purchase-order",
    "document-processing"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "pdfkit": "^0.15.2"
  }
}
