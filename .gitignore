node_modules/
batches.json
sample_pdfs/
pdfs/
*.log

# local-llm: training artifacts, extracted text, and trained checkpoints are
# user-specific (and can be large / derived from private documents) — never
# committed. Only the pipeline code and the labels template are tracked.
local-llm/venv/
local-llm/checkpoints/
local-llm/data/texts/
local-llm/data/*.jsonl
!local-llm/data/labels.template.jsonl
local-llm/__pycache__/
**/__pycache__/
*.pyc
