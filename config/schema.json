  "documentTypes": [
    {
      "name": "Invoice",
      "description": "A request for payment from a seller to a buyer: tax invoice, commercial invoice, bill.",
      "keywords": [
        "Tax Invoice",
        "Commercial Invoice",
        "Invoice",
        "Invoice No",
        "Invoice Number",
        "Invoice Date",
        "Bill To",
        "Amount Due",
        "Total Due",
        "Due Date",
        "GSTIN",
        "VAT"
      ],
      "keywordWeight": 5
    },
    {
      "name": "Credit Note",
      "description": "A document reducing or reversing an amount previously invoiced.",
      "keywords": [
        "Credit Note",
        "Credit Memo",
        "Credit Note No",
        "Original Invoice",
        "Amount Credited"
      ],
      "keywordWeight": 7
    },
    {
      "name": "Purchase Order",
      "description": "A buyer's order authorizing a purchase from a vendor.",
      "keywords": [
        "Purchase Order",
        "PO No",
        "P.O.",
        "Order Date",
        "Vendor",
        "Ship To",
        "Delivery Date"
      ],
      "keywordWeight": 5
    },
    {
      "name": "Quotation",
      "description": "A seller's price offer or proforma invoice issued before an order.",
      "keywords": [
        "Quotation",
        "Quote",
        "Proforma Invoice",
        "Estimate",
        "Valid Until",
        "Quote No"
      ],
      "keywordWeight": 6
    },
    {
      "name": "Receipt",
      "description": "Proof of a completed payment: till receipt, payment receipt, cash receipt.",
      "keywords": [
        "Receipt",
        "Receipt No",
        "Receipt Number",
        "Cash Receipt",
        "Payment Received",
        "Amount Paid",
        "Paid",
        "Change"
      ],
      "keywordWeight": 4
    },
    {
      "name": "Bank Statement",
      "description": "A periodic account statement listing transactions and balances.",
      "keywords": [
        "Account Statement",
        "Bank Statement",
        "Statement Period",
        "Opening Balance",
        "Closing Balance",
        "Account Number",
        "IBAN",
        "Transaction",
        "Debit",
        "Credit",
        "Balance"
      ],
      "keywordWeight": 4
    },
    {
      "name": "Unknown",
      "description": "Anything that does not match another configured document type."
