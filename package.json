{
  "name": "document-classifier",
  "version": "2.0.0",
  "description": "Self-contained document classifier: PDF-to-text (with offline OCR fallback for scanned PDFs), from-scratch heuristic field extraction, and batching. No cloud, no LLM.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "classify": "node index.js",
    "web": "node server.js",
    "generate-samples": "node scripts/generate-samples.js",
    "generate-fixtures": "node scripts/generate-fixtures.js",
    "setup": "bash scripts/setup.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "audit:secrets": "bash scripts/security-scan.sh"
  },
  "keywords": [
    "pdf",
    "ocr",
    "tesseract",
    "classification",
    "invoice",
    "document-processing"
  ],
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@tesseract.js-data/eng": "^1.0.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pdfkit": "^0.15.2",
    "typescript": "^7.0.2"
  }
}
