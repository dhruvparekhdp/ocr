  "validations": [
    {
      "rule": "sum",
      "fields": [
        "subtotal",
        "taxAmount"
      ],
      "equals": "totalAmount"
    },
    {
      "rule": "sumColumn",
      "table": "lineItems",
      "column": "amount",
      "equals": "subtotal"
    },
    {
      "rule": "notBefore",
      "field": "dueDate",
      "reference": "documentDate"
    },
    {
      "rule": "notBefore",
      "field": "periodEnd",
      "reference": "periodStart"
    },
    {
      "rule": "balance",
      "opening": "openingBalance",
      "table": "transactions",
      "credit": "credit",
      "debit": "debit",
      "closing": "closingBalance"
    }
  ]
}
